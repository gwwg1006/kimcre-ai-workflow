# 모두 비워 두어도 데모는 mock 모드로 실행된다.

# 로컬 LLM으로 요구사항 추출: ollama 로 설정하면 사용, 비우면 규칙 파서
LOCAL_LLM=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 외부 LLM(응대문 다듬기 전용, 개인정보 없는 텍스트만 전송). 비우면 호출하지 않음
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 알림: email 이면 SMTP 발송, 비우면 mock
NOTIFY_MODE=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
